{
  "name": "visage",
  "version": "0.1.0",
  "description": "Lightning-fast, zero-VDOM, fine-grained reactive UI library with full TypeScript support",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./signals": {
      "types": "./src/signals/index.ts",
      "import": "./src/signals/index.ts"
    },
    "./dom": {
      "types": "./src/dom/index.ts",
      "import": "./src/dom/index.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "import": "./src/router/index.ts"
    },
    "./template": {
      "types": "./src/template/index.ts",
      "import": "./src/template/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./form": {
      "types": "./src/form/index.ts",
      "import": "./src/form/index.ts"
    },
    "./virtual": {
      "types": "./src/virtual/index.ts",
      "import": "./src/virtual/index.ts"
    },
    "./query": {
      "types": "./src/query/index.ts",
      "import": "./src/query/index.ts"
    },
    "./rpc": {
      "types": "./src/rpc/index.ts",
      "import": "./src/rpc/index.ts"
    },
    "./api": {
      "types": "./src/api/index.ts",
      "import": "./src/api/index.ts"
    },
    "./style": {
      "types": "./src/style/index.ts",
      "import": "./src/style/index.ts"
    },
    "./devtools": {
      "types": "./src/devtools/index.ts",
      "import": "./src/devtools/index.ts"
    },
    "./vite": {
      "types": "./src/vite/index.ts",
      "import": "./src/vite/index.ts"
    },
    "./ui": {
      "types": "./src/ui/index.ts",
      "import": "./src/ui/index.ts"
    },
    "./charts": {
      "types": "./src/charts/index.ts",
      "import": "./src/charts/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime/index.ts",
      "import": "./src/jsx-runtime/index.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-runtime/index.ts",
      "import": "./src/jsx-runtime/index.ts"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Epoch32/visage.git"
  },
  "bugs": {
    "url": "https://github.com/Epoch32/visage/issues"
  },
  "homepage": "https://github.com/Epoch32/visage#readme",
  "author": "Epoch32",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "bun build src/index.ts src/signals/index.ts src/dom/index.ts src/template/index.ts src/api/index.ts src/rpc/index.ts src/query/index.ts src/style/index.ts src/devtools/index.ts src/ui/index.ts src/virtual/index.ts src/form/index.ts src/server/index.ts src/router/index.ts src/vite/index.ts src/jsx-runtime/index.ts src/charts/index.ts --outdir dist/",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:vitest": "vitest run",
    "typecheck": "bun x tsc --noEmit",
    "check": "bun x @biomejs/biome check --write .",
    "check:ci": "bun x @biomejs/biome check .",
    "lint": "bun x @biomejs/biome lint .",
    "format": "bun x @biomejs/biome format --write .",
    "verify": "bun test && bun run build",
    "prepublishOnly": "bun run verify",
    "example:survey": "bun examples/survey/server.ts",
    "example:ui": "vite examples/ui-showcase",
    "example:charts": "vite examples/charts-showcase",
    "example:auth": "vite examples/enterprise-auth",
    "example:api": "bun examples/api-showcase/server.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "csstype": "^3.2.3",
    "lucide": "^1.54.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "reactive",
    "signals",
    "no-vdom",
    "jsx",
    "ssr",
    "form",
    "validation",
    "router",
    "template",
    "typescript",
    "ui"
  ],
  "license": "MPL-2.0"
}
