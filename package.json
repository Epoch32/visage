{
  "name": "visage",
  "version": "0.1.0",
  "description": "Lightning-fast, zero-VDOM, fine-grained reactive UI library with full TypeScript support",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./signals": {
      "types": "./src/signals/index.ts",
      "import": "./src/signals/index.ts"
    },
    "./dom": {
      "types": "./src/dom/index.ts",
      "import": "./src/dom/index.ts"
    },
    "./router": {
      "types": "./src/router/index.ts",
      "import": "./src/router/index.ts"
    },
    "./template": {
      "types": "./src/template/index.ts",
      "import": "./src/template/index.ts"
    },
    "./server": {
      "types": "./src/server/index.ts",
      "import": "./src/server/index.ts"
    },
    "./form": {
      "types": "./src/form/index.ts",
      "import": "./src/form/index.ts"
    },
    "./virtual": {
      "types": "./src/virtual/index.ts",
      "import": "./src/virtual/index.ts"
    },
    "./query": {
      "types": "./src/query/index.ts",
      "import": "./src/query/index.ts"
    },
    "./rpc": {
      "types": "./src/rpc/index.ts",
      "import": "./src/rpc/index.ts"
    },
    "./jsx-runtime": {
      "types": "./src/jsx-runtime/index.ts",
      "import": "./src/jsx-runtime/index.ts"
    },
    "./jsx-dev-runtime": {
      "types": "./src/jsx-runtime/index.ts",
      "import": "./src/jsx-runtime/index.ts"
    }
  },
  "scripts": {
    "test": "bun test",
    "test:vitest": "vitest run",
    "typecheck": "bun x tsc --noEmit",
    "check": "bun x @biomejs/biome check --write .",
    "lint": "bun x @biomejs/biome lint .",
    "format": "bun x @biomejs/biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "reactive",
    "signals",
    "no-vdom",
    "jsx",
    "ssr",
    "form",
    "validation",
    "router",
    "template",
    "typescript",
    "ui"
  ],
  "license": "MIT"
}
