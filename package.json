{
  "name": "@epoch32/visage",
  "version": "2.2.0",
  "description": "Lightning-fast, zero-VDOM, fine-grained reactive UI library with full TypeScript support",
  "type": "module",
  "workspaces": [
    "examples/*"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./signals": {
      "types": "./dist/signals/index.d.ts",
      "import": "./dist/signals/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./router": {
      "types": "./dist/router/index.d.ts",
      "import": "./dist/router/index.js"
    },
    "./template": {
      "types": "./dist/template/index.d.ts",
      "import": "./dist/template/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "import": "./dist/http/index.js"
    },
    "./form": {
      "types": "./dist/form/index.d.ts",
      "import": "./dist/form/index.js"
    },
    "./virtual": {
      "types": "./dist/virtual/index.d.ts",
      "import": "./dist/virtual/index.js"
    },
    "./query": {
      "types": "./dist/query/index.d.ts",
      "import": "./dist/query/index.js"
    },
    "./rpc": {
      "types": "./dist/rpc/index.d.ts",
      "import": "./dist/rpc/index.js"
    },
    "./api": {
      "types": "./dist/api/index.d.ts",
      "import": "./dist/api/index.js"
    },
    "./style": {
      "types": "./dist/style/index.d.ts",
      "import": "./dist/style/index.js"
    },
    "./devtools": {
      "types": "./dist/devtools/index.d.ts",
      "import": "./dist/devtools/index.js"
    },
    "./io": {
      "types": "./dist/io/index.d.ts",
      "import": "./dist/io/index.js"
    },
    "./i18n": {
      "types": "./dist/i18n/index.d.ts",
      "import": "./dist/i18n/index.js"
    },
    "./vite": {
      "types": "./dist/vite/index.d.ts",
      "import": "./dist/vite/index.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "import": "./dist/ui/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./native": {
      "types": "./dist/native/index.d.ts",
      "import": "./dist/native/index.js"
    },
    "./jsx-runtime": {
      "types": "./dist/jsx-runtime/index.d.ts",
      "import": "./dist/jsx-runtime/index.js"
    },
    "./jsx-dev-runtime": {
      "types": "./dist/jsx-runtime/index.d.ts",
      "import": "./dist/jsx-runtime/index.js"
    }
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Epoch32/visage.git"
  },
  "bugs": {
    "url": "https://github.com/Epoch32/visage/issues"
  },
  "homepage": "https://github.com/Epoch32/visage#readme",
  "author": "Epoch32",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE",
    "package.json"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:vitest": "vitest run",
    "typecheck": "bun x tsc --noEmit",
    "check": "bun x @biomejs/biome check --write .",
    "check:ci": "bun x @biomejs/biome check .",
    "lint": "bun x @biomejs/biome lint .",
    "format": "bun x @biomejs/biome format --write .",
    "verify": "bun test && bun run build",
    "prepublishOnly": "bun run verify",
    "example:survey": "bun examples/survey/server.ts",
    "example:ui": "vite examples/ui-showcase",
    "example:charts": "vite examples/charts-showcase",
    "example:auth": "vite examples/enterprise-auth",
    "example:api": "bun examples/api-showcase/server.ts",
    "example:benchmark": "vite examples/benchmark-showcase",
    "example:sim": "vite examples/traffic-sim"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/generator": "^8.0.6",
    "@babel/parser": "^8.0.7",
    "@babel/traverse": "^8.0.7",
    "@babel/types": "^8.0.6",
    "@biomejs/biome": "^2.5.15",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__traverse": "^7.28.0",
    "@types/bun": "^1.4.3",
    "@types/node": "^22.0.0",
    "csstype": "^3.2.3",
    "happy-dom": "^21.0.1",
    "lucide": "^1.54.0",
    "picocolors": "^1.1.1",
    "puppeteer-core": "^25.13.0",
    "solid-js": "^1.9.17",
    "typescript": "^7.0.2",
    "vite": "^5.4.21",
    "vite-plugin-solid": "^2.11.14",
    "vitest": "^5.0.3"
  },
  "keywords": [
    "reactive",
    "signals",
    "no-vdom",
    "jsx",
    "ssr",
    "form",
    "validation",
    "router",
    "template",
    "typescript",
    "ui"
  ],
  "license": "MPL-2.0"
}
