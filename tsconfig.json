{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "exactOptionalPropertyTypes": false,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@epoch32/visage",
    "paths": {
      "@": ["./src/index.ts"],
      "@/*": ["./src/*"],
      "@api": ["./src/api/index.ts"],
      "@api/*": ["./src/api/*"],
      "@charts": ["./src/charts/index.ts"],
      "@charts/*": ["./src/charts/*"],
      "@devtools": ["./src/devtools/index.ts"],
      "@devtools/*": ["./src/devtools/*"],
      "@dom": ["./src/dom/index.ts"],
      "@dom/*": ["./src/dom/*"],
      "@form": ["./src/form/index.ts"],
      "@form/*": ["./src/form/*"],
      "@http": ["./src/http/index.ts"],
      "@http/*": ["./src/http/*"],
      "@i18n": ["./src/i18n/index.ts"],
      "@i18n/*": ["./src/i18n/*"],
      "@io": ["./src/io/index.ts"],
      "@io/*": ["./src/io/*"],
      "@jsx-runtime": ["./src/jsx-runtime/index.ts"],
      "@jsx-runtime/*": ["./src/jsx-runtime/*"],
      "@jsx-dev-runtime": ["./src/jsx-dev-runtime/index.ts"],
      "@jsx-dev-runtime/*": ["./src/jsx-dev-runtime/*"],
      "@native": ["./src/native/index.ts"],
      "@native/*": ["./src/native/*"],
      "@query": ["./src/query/index.ts"],
      "@query/*": ["./src/query/*"],
      "@router": ["./src/router/index.ts"],
      "@router/*": ["./src/router/*"],
      "@rpc": ["./src/rpc/index.ts"],
      "@rpc/*": ["./src/rpc/*"],
      "@server": ["./src/server/index.ts"],
      "@server/*": ["./src/server/*"],
      "@signals": ["./src/signals/index.ts"],
      "@signals/*": ["./src/signals/*"],
      "@style": ["./src/style/index.ts"],
      "@style/*": ["./src/style/*"],
      "@template": ["./src/template/index.ts"],
      "@template/*": ["./src/template/*"],
      "@ui": ["./src/ui/index.ts"],
      "@ui/*": ["./src/ui/*"],
      "@virtual": ["./src/virtual/index.ts"],
      "@virtual/*": ["./src/virtual/*"],
      "@vite": ["./src/vite/index.ts"],
      "@vite/*": ["./src/vite/*"],
      "@epoch32/visage": ["./src/index.ts"],
      "@epoch32/visage/jsx-runtime": ["./src/jsx-runtime/index.ts"],
      "@epoch32/visage/jsx-dev-runtime": ["./src/jsx-runtime/index.ts"],
      "@epoch32/visage/charts": ["./src/charts/index.ts"],
      "@epoch32/visage/ui": ["./src/ui/index.ts"],
      "@epoch32/visage/style": ["./src/style/index.ts"],
      "@epoch32/visage/signals": ["./src/signals/index.ts"],
      "@epoch32/visage/vite": ["./src/vite/index.ts"],
      "@epoch32/visage/*": ["./src/*"],
      "visage": ["./src/index.ts"],
      "visage/jsx-runtime": ["./src/jsx-runtime/index.ts"],
      "visage/jsx-dev-runtime": ["./src/jsx-runtime/index.ts"],
      "visage/router": ["./src/router/index.ts"],
      "visage/template": ["./src/template/index.ts"],
      "visage/server": ["./src/server/index.ts"],
      "visage/form": ["./src/form/index.ts"],
      "visage/virtual": ["./src/virtual/index.ts"],
      "visage/query": ["./src/query/index.ts"],
      "visage/rpc": ["./src/rpc/index.ts"],
      "visage/style": ["./src/style/index.ts"],
      "visage/devtools": ["./src/devtools/index.ts"],
      "visage/api": ["./src/api/index.ts"],
      "visage/ui": ["./src/ui/index.ts"],
      "visage/charts": ["./src/charts/index.ts"],
      "visage/vite": ["./src/vite/index.ts"],
      "visage/*": ["./src/*"]
    },
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*"]
}
